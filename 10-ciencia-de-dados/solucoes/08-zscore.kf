Double media(List<Double> dados) {
    var soma = 0.0
    for (var x in dados) {
        soma = soma + x
    }
    return soma / dados.size
}
Double desvioPadrao(List<Double> dados) {
    var m = media(dados)
    var soma = 0.0
    for (var x in dados) {
        soma = soma + (x - m) * (x - m)
    }
    // 0.5.0: a resolução de math.sqrt não aplica widening de Int→Double no
    // argumento — materialize o Double antes (variância média).
    var variancia: Double = soma / dados.size
    return math.sqrt(variancia)
}
List<Double> zScore(List<Double> dados) {
    var m = media(dados)
    var d = desvioPadrao(dados)
    var r = listOf<Double>()
    for (var x in dados) {
        r.add((x - m) / d)
    }
    return r
}
main() {
    println(zScore(listOf(10.0, 20.0, 30.0, 40.0)))
}
