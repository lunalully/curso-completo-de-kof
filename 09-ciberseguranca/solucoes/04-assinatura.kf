String assinar(String msg, String chave) {
    return crypto.hmacSha256(chave, msg)
}
Bool verificar(String msg, String chave, String ass) {
    return security.constantTimeEquals(ass, crypto.hmacSha256(chave, msg))
}
main() {
    var chave = "segredo-compartilhado"
    var msg = "{\"transf\": 1000}"
    var ass = assinar(msg, chave)
    println(verificar(msg, chave, ass))            // true
    println(verificar(msg, "chave-errada", ass))   // false
}
