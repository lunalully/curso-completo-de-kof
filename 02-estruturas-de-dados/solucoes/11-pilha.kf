class Pilha {
    List<Int> itens
    constructor() {
        itens = listOf()
    }
    void empilhar(Int v) {
        itens.add(v)
    }
    Int desempilhar() {
        if (itens.size == 0) {
            throw "pilha vazia"
        }
        var t = itens.get(itens.size - 1)
        itens.remove(itens.size - 1)
        return t
    }
    Int topo() {
        if (itens.size == 0) {
            throw "pilha vazia"
        }
        return itens.get(itens.size - 1)
    }
    Bool vazia() {
        return itens.size == 0
    }
}
main() {
    var p = Pilha()
    p.empilhar(1)
    p.empilhar(2)
    p.empilhar(3)
    println(p.topo())
    println(p.desempilhar())
    println(p.desempilhar())
}
