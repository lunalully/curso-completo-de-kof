class FilaCircular {
    Int[] buffer
    Int inicio
    Int fim
    Int n
    constructor(Int capacidade) {
        buffer = new Int[capacidade]
        inicio = 0
        fim = 0
        n = 0
    }
    Bool cheia() {
        return n == buffer.length
    }
    Bool vazia() {
        return n == 0
    }
    void enfileirar(Int v) {
        if (cheia()) {
            throw "fila cheia"
        }
        buffer[fim] = v
        fim = (fim + 1) % buffer.length
        n = n + 1
    }
    Int desenfileirar() {
        if (vazia()) {
            throw "fila vazia"
        }
        var v = buffer[inicio]
        inicio = (inicio + 1) % buffer.length
        n = n - 1
        return v
    }
}
main() {
    var teclas = FilaCircular(5)
    teclas.enfileirar(65)   // A
    teclas.enfileirar(66)   // B
    teclas.enfileirar(67)   // C
    teclas.enfileirar(68)   // D
    teclas.enfileirar(69)   // E
    println(teclas.desenfileirar())   // 65
    println(teclas.desenfileirar())   // 66
    teclas.enfileirar(70)             // F
    println(teclas.desenfileirar())   // 67
}
