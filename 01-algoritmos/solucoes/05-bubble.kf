void trocar(List<Int> l, Int i, Int j) {
    var t = l.get(i)
    l.set(i, l.get(j))
    l.set(j, t)
}
List<Int> bubbleSort(List<Int> l) {
    var n = l.size
    for (var i = 0; i < n - 1; i = i + 1) {
        for (var j = 0; j < n - 1 - i; j = j + 1) {
            if (l.get(j) > l.get(j + 1)) {
                trocar(l, j, j + 1)
            }
        }
    }
    return l
}
main() {
    println(bubbleSort(listOf(5, 1, 4, 2, 8)))
}
