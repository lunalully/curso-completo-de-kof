// String compara por conteúdo (==) e ordena com compareTo
// (0.5.0: `<` em String é SEM053 — ordem lexicográfica difere por target)
Int buscaBinariaString(List<String> lista, String alvo) {
    var baixo = 0
    var alto = lista.size - 1
    while (baixo <= alto) {
        var meio = (baixo + alto) / 2
        var valor = lista.get(meio)
        if (valor == alvo) {
            return meio
        }
        if (valor.compareTo(alvo) < 0) {
            baixo = meio + 1
        } else {
            alto = meio - 1
        }
    }
    throw "nao encontrado: " + alvo
}
main() {
    var nomes = listOf("ada", "kof", "mel", "pedro")
    println(buscaBinariaString(nomes, "kof"))   // 1
}
