List<Int> mergeSort(List<Int> l) {
    if (l.size <= 1) {
        return l
    }
    var meio = l.size / 2
    var esq = listOf<Int>()
    var dir = listOf<Int>()
    for (var i = 0; i < meio; i = i + 1) {
        esq.add(l.get(i))
    }
    for (var i = meio; i < l.size; i = i + 1) {
        dir.add(l.get(i))
    }
    return merge(mergeSort(esq), mergeSort(dir))
}
List<Int> merge(List<Int> a, List<Int> b) {
    var r = listOf<Int>()
    var i = 0
    var j = 0
    while (i < a.size && j < b.size) {
        if (a.get(i) < b.get(j)) {
            r.add(a.get(i))
            i = i + 1
        } else {
            r.add(b.get(j))
            j = j + 1
        }
    }
    while (i < a.size) {
        r.add(a.get(i))
        i = i + 1
    }
    while (j < b.size) {
        r.add(b.get(j))
        j = j + 1
    }
    return r
}
main() {
    println(mergeSort(listOf(42, 7, 11, 3, 19, 1, 99)))
}
