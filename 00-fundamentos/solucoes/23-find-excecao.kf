// Solução 23 — find com exceção
Int find(List<Int> lista, Int alvo) {
    for (var i = 0; i < lista.size; i = i + 1) {
        if (lista.get(i) == alvo) {
            return i
        }
    }
    throw "nao encontrado: " + alvo
}
main() {
    try {
        var idx = find(listOf(10, 20, 30), 20)
        println(idx)
        find(listOf(10, 20, 30), 99)
    } catch (String e) {
        println("falhou: " + e)
    }
}
