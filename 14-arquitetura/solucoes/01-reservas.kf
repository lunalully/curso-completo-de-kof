// Domínio de reservas: dados (record) + comportamento (classe) + lógica (função)
record Reserva(String id, String sala, Int horario)

class Salas {
    List<String> nomes
    constructor() {
        nomes = listOf()
    }
    Bool existe(String nome) {
        return nomes.contains(nome)
    }
}

Bool conflita(List<Reserva> reservas, Reserva nova) {
    for (var r in reservas) {
        if (r.sala == nova.sala && r.horario == nova.horario) {
            return true
        }
    }
    return false
}

main() {
    var salas = Salas()
    salas.nomes.add("A1")
    salas.nomes.add("B2")

    var reservas = listOf(Reserva("r1", "A1", 10))
    println(salas.existe("A1"))                     // true
    println(conflita(reservas, Reserva("r2", "A1", 10)))  // true (conflito)
    println(conflita(reservas, Reserva("r3", "B2", 10)))  // false
}
