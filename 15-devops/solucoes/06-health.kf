// Serviço com /health + logs configuráveis (KOF_LOG_LEVEL)
main() {
    var app = web.app()
    app.use {
        log.info("health-svc: " + method() + " " + path())
        return null
    }
    app.get("/health") {
        return "{\"status\": \"ok\", \"servico\": \"deploy\"}"
    }
    app.get("/") {
        return "kof deploy demo"
    }
    app.listen(config.int("server.port", 8080))
}
